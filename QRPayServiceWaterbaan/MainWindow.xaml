<mah:MetroWindow x:Class="QRPayServiceWaterbaan.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
        xmlns:local="clr-namespace:QRPayServiceWaterbaan"
        mc:Ignorable="d"
        Title="Bulk EPC QR Code generator"
        Height="600" Width="900"
        GlowBrush="{DynamicResource AccentColorBrush}"
        WindowStartupLocation="CenterScreen"
        ShowIconOnTitleBar="True"
        Loaded="Window_Loaded">
    <mah:MetroWindow.Resources>
    </mah:MetroWindow.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Instructies -->
        <Border Grid.Row="0" Background="{DynamicResource MahApps.Brushes.ThemeBackground}" Padding="12" CornerRadius="4" Margin="0,0,0,16">
            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource MahApps.Brushes.Gray1}">
                Vul de verplichte velden in en genereer een enkele QR of meerdere via een tekstbestand. Het bedrag kan als geheel getal of met decimalen (bv. 12,50) ingegeven worden.
            </TextBlock>
        </Border>

        <!-- Naam -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Naam" VerticalAlignment="Center" />
            <TextBox x:Name="NameTextBox" Grid.Column="1" Height="32" mah:TextBoxHelper.Watermark="Naam begunstigde" TextChanged="Input_TextChanged" />
        </Grid>

        <!-- IBAN -->
        <Grid Grid.Row="2" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Bankrekening (IBAN)" VerticalAlignment="Center" />
            <TextBox x:Name="IbanTextBox" Grid.Column="1" Height="32" mah:TextBoxHelper.Watermark="BE.." CharacterCasing="Upper" TextChanged="Input_TextChanged" />
        </Grid>

        <!-- Bedrag -->
        <Grid Grid.Row="3" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Bedrag (€)" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="€" Margin="0,0,8,0" VerticalAlignment="Center" FontSize="16" />
                <TextBox x:Name="AmountTextBox" Height="32" Width="180" mah:TextBoxHelper.Watermark="0,00" TextChanged="Input_TextChanged" />
            </StackPanel>
        </Grid>

        <!-- Opmerking -->
        <Grid Grid.Row="4" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Opmerking" VerticalAlignment="Top" />
            <TextBox x:Name="RemarkTextBox" Grid.Column="1" Height="100" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" mah:TextBoxHelper.Watermark="Optionele omschrijving" />
        </Grid>

        <!-- Actie knoppen -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,0,0,12">
            <Button x:Name="GenereerButton" Content="Genereer enkele QR" Width="180" Height="40" Margin="0,0,12,0" Click="GenereerButton_Click" IsEnabled="False" />
            <Button x:Name="LaadVanLijstButton" Content="Bulk uit lijst" Width="140" Height="40" Margin="0,0,12,0" Click="LaadVanLijstButton_Click" IsEnabled="False" />
            <Button x:Name="HelpButton" Content="Help" Width="100" Height="40" Click="HelpButton_Click" />
        </StackPanel>

        <!-- QR preview & acties -->
        <Border Grid.Row="6" BorderBrush="{DynamicResource MahApps.Brushes.Gray2}" BorderThickness="1" Padding="12" CornerRadius="4" Background="{DynamicResource MahApps.Brushes.ThemeBackground}">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Top" Margin="0,0,0,8">
                    <Button x:Name="CopyQrButton" Content="Kopieer QR" Width="120" Height="32" Margin="0,0,8,0" Click="CopyQrButton_Click" IsEnabled="False" />
                    <Button x:Name="SaveQrButton" Content="Bewaar QR..." Width="120" Height="32" Click="SaveQrButton_Click" IsEnabled="False" />
                </StackPanel>
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                    <Image x:Name="QrImage" Width="350" Height="350" Stretch="Uniform" />
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Statusbar -->
        <StatusBar Grid.Row="7" Margin="0,12,0,0">
            <StatusBarItem>
                <TextBlock x:Name="StatusTextBlock" Text="Klaar" />
            </StatusBarItem>
            <StatusBarItem Width="200">
                <ProgressBar x:Name="BatchProgressBar" Height="16" Minimum="0" Maximum="100" Visibility="Collapsed" />
            </StatusBarItem>
        </StatusBar>
    </Grid>
</mah:MetroWindow>
